function setStatus(
  message,
  type
) {

  const status =
    document.getElementById(
      'status'
    );


  status.textContent =
    message;


  status.className =
    'status ' +
    (type || '');

}


/*******************************************************
 * ÂM THANH
 *******************************************************/

function beep() {

  try {

    const AudioContext =
      window.AudioContext ||
      window.webkitAudioContext;


    const audio =
      new AudioContext();


    const oscillator =
      audio.createOscillator();


    const gain =
      audio.createGain();


    oscillator.frequency.value =
      1100;


    oscillator.type =
      'sine';


    gain.gain.value =
      0.08;


    oscillator.connect(
      gain
    );


    gain.connect(
      audio.destination
    );


    oscillator.start();


    oscillator.stop(
      audio.currentTime + 0.08
    );

  } catch (e) {

    // Không làm ảnh hưởng quá trình quét

  }

}


