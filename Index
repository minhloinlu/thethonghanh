<!DOCTYPE html>

<html lang="vi">

<head>

  <base target="_top">

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width,
             initial-scale=1,
             maximum-scale=1,
             user-scalable=no"
  >

  <title>Quét MSSV</title>


  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f4f6f8;
      font-family:
        Arial,
        Helvetica,
        sans-serif;
      color: #202124;
    }


    .app {
      max-width: 650px;
      margin: auto;
      padding: 18px;
    }


    .header {
      background: #ffffff;
      border-radius: 18px;
      padding: 18px;
      margin-bottom: 15px;
      box-shadow:
        0 3px 15px rgba(0,0,0,.08);
    }


    .title {
      font-size: 23px;
      font-weight: 800;
      margin-bottom: 5px;
    }


    .subtitle {
      color: #70757a;
      font-size: 14px;
      line-height: 1.4;
    }


    .scanner {
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      background: #000;
      aspect-ratio: 4 / 3;
      box-shadow:
        0 5px 20px rgba(0,0,0,.15);
    }


    #video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }


    #canvas {
      display: none;
    }


    .scan-frame {
      position: absolute;
      left: 8%;
      right: 8%;
      top: 35%;
      height: 30%;
      border: 3px solid #00d084;
      border-radius: 10px;
      pointer-events: none;
    }


    .scan-line {
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      height: 2px;
      background: #00d084;
      box-shadow:
        0 0 8px #00d084;
    }


    .hint {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 12px;
      text-align: center;
      color: white;
      font-size: 13px;
      text-shadow:
        0 1px 3px #000;
    }


    .status {
      margin-top: 14px;
      background: white;
      border-radius: 14px;
      padding: 15px;
      text-align: center;
      font-weight: 700;
      min-height: 52px;
      display: flex;
      justify-content: center;
      align-items: center;
    }


    .status.success {
      background: #e9f9ef;
      color: #087a35;
    }


    .status.error {
      background: #fff0f0;
      color: #b42318;
    }


    .status.warning {
      background: #fff8e6;
      color: #8a5a00;
    }


    .result {
      background: white;
      border-radius: 18px;
      padding: 18px;
      margin-top: 15px;
    }


    .result-label {
      font-size: 13px;
      color: #777;
      margin-bottom: 5px;
    }


    .mssv {
      font-size: 32px;
      font-weight: 900;
      letter-spacing: 1px;
      text-align: center;
      padding: 8px;
    }


    .buttons {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 15px;
    }


    button {
      border: none;
      border-radius: 13px;
      padding: 14px;
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
    }


    .primary {
      background: #1463ff;
      color: white;
    }


    .secondary {
      background: #e9edf2;
      color: #202124;
    }


    button:disabled {
      opacity: .5;
      cursor: default;
    }


    .manual {
      background: white;
      border-radius: 18px;
      padding: 18px;
      margin-top: 15px;
    }


    .manual-title {
      font-weight: 800;
      margin-bottom: 10px;
    }


    .manual-row {
      display: flex;
      gap: 8px;
    }


    input {
      flex: 1;
      min-width: 0;
      border: 1px solid #d6d9dd;
      border-radius: 12px;
      padding: 13px;
      font-size: 18px;
      outline: none;
    }


    input:focus {
      border-color: #1463ff;
    }


    .history {
      background: white;
      border-radius: 18px;
      margin-top: 15px;
      padding: 18px;
    }


    .history-title {
      font-weight: 800;
      margin-bottom: 10px;
    }


    .history-item {
      display: flex;
      justify-content: space-between;
      padding: 9px 0;
      border-bottom: 1px solid #eee;
      font-size: 14px;
    }


    .history-item:last-child {
      border-bottom: none;
    }


    .code {
      font-weight: 800;
    }


    .time {
      color: #777;
    }


    .counter {
      text-align: center;
      color: #777;
      font-size: 13px;
      margin-top: 10px;
    }


    @media(max-width: 480px) {

      .app {
        padding: 10px;
      }

      .title {
        font-size: 20px;
      }

      .mssv {
        font-size: 27px;
      }

    }

  </style>

</head>


<body>


<div class="app">


  <div class="header">

    <div class="title">
      📷 QUÉT MÃ VẠCH MSSV
    </div>

    <div class="subtitle">
      Chế độ đặc biệt: đọc Code 39 bị thiếu
      ký tự Start/Stop <b>*</b>.
    </div>

  </div>


  <div class="scanner">

    <video
      id="video"
      autoplay
      muted
      playsinline
    ></video>

    <canvas id="canvas"></canvas>

    <div class="scan-frame">
      <div class="scan-line"></div>
    </div>

    <div class="hint">
      Đưa toàn bộ mã vạch vào khung
    </div>

  </div>


  <div
    id="status"
    class="status warning"
  >
    Nhấn "Bật camera" để bắt đầu
  </div>


  <div class="result">

    <div class="result-label">
      MSSV vừa nhận diện
    </div>

    <div
      id="currentMSSV"
      class="mssv"
    >
      —
    </div>

  </div>


  <div class="buttons">

    <button
      id="startBtn"
      class="primary"
      onclick="startCamera()"
    >
      📷 Bật camera
    </button>

    <button
      id="stopBtn"
      class="secondary"
      onclick="stopCamera()"
      disabled
    >
      ⏹ Dừng
    </button>

  </div>


  <div class="manual">

    <div class="manual-title">
      Nhập thủ công
    </div>

    <div class="manual-row">

      <input
        id="manualInput"
        type="text"
        inputmode="numeric"
        maxlength="10"
        placeholder="Nhập MSSV"
        autocomplete="off"
      >

      <button
        class="primary"
        onclick="saveManual()"
      >
        Lưu
      </button>

    </div>

  </div>


  <div class="history">

    <div class="history-title">
      Lịch sử phiên này
    </div>

    <div id="historyList">
      Chưa có dữ liệu
    </div>

    <div
      id="counter"
      class="counter"
    >
      Đã ghi: 0
    </div>

  </div>


</div>


<script>


/*******************************************************
 * CODE 39 TABLE
 *******************************************************/

const ALPHABET =
  "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-. $/+%";


const CHARACTER_ENCODINGS = [

  0x034, 0x121, 0x061, 0x160,
  0x031, 0x130, 0x070, 0x025,
  0x124, 0x064,

  0x109, 0x049, 0x148, 0x019,
  0x118, 0x058, 0x00D, 0x10C,
  0x04C, 0x01C,

  0x103, 0x043, 0x142, 0x013,
  0x112, 0x052, 0x007, 0x106,
  0x046, 0x016,

  0x181, 0x0C1, 0x1C0, 0x091,
  0x190, 0x0D0, 0x085, 0x184,
  0x0C4, 0x0A8,

  0x0A2, 0x08A, 0x02A

];


const video =
  document.getElementById('video');


const canvas =
  document.getElementById('canvas');


const ctx =
  canvas.getContext('2d', {
    willReadFrequently: true
  });


let stream = null;

let scanning = false;

let animationId = null;

let lastSavedCode = '';

let lastSavedAt = 0;

let totalSaved = 0;

let lastScanTime = 0;


/*******************************************************
 * CAMERA
 *******************************************************/

async function startCamera() {

  if (!navigator.mediaDevices ||
      !navigator.mediaDevices.getUserMedia) {

    setStatus(
      'Trình duyệt không hỗ trợ camera.',
      'error'
    );

    return;
  }


  try {

    stream =
      await navigator.mediaDevices.getUserMedia({

        video: {

          facingMode: {
            ideal: 'environment'
          },

          width: {
            ideal: 1280
          },

          height: {
            ideal: 720
          },

          frameRate: {
            ideal: 30,
            max: 30
          }

        },

        audio: false

      });


    video.srcObject = stream;

    await video.play();


    document.getElementById(
      'startBtn'
    ).disabled = true;


    document.getElementById(
      'stopBtn'
    ).disabled = false;


    setStatus(
      'Đang quét... Đưa mã vạch vào khung.',
      'warning'
    );


    scanning = true;

    scanLoop();

  } catch (error) {

    console.error(error);

    setStatus(
      'Không thể mở camera. Hãy cấp quyền Camera cho trình duyệt.',
      'error'
    );

  }

}


/*******************************************************
 * STOP CAMERA
 *******************************************************/

function stopCamera() {

  scanning = false;


  if (animationId) {

    cancelAnimationFrame(animationId);

    animationId = null;

  }


  if (stream) {

    stream.getTracks().forEach(
      track => track.stop()
    );

    stream = null;

  }


  video.srcObject = null;


  document.getElementById(
    'startBtn'
  ).disabled = false;


  document.getElementById(
    'stopBtn'
  ).disabled = true;


  setStatus(
    'Camera đã dừng.',
    'warning'
  );

}


/*******************************************************
 * SCAN LOOP
 *******************************************************/

function scanLoop(timestamp) {

  if (!scanning) return;


  animationId =
    requestAnimationFrame(scanLoop);


  // Không xử lý quá dày
  if (
    timestamp - lastScanTime < 120
  ) {
    return;
  }


  lastScanTime = timestamp;


  if (
    video.readyState <
    HTMLMediaElement.HAVE_CURRENT_DATA
  ) {
    return;
  }


  if (
    video.videoWidth === 0 ||
    video.videoHeight === 0
  ) {
    return;
  }


  // Giới hạn kích thước để giảm tải CPU
  const maxWidth = 960;

  const scale =
    Math.min(
      1,
      maxWidth / video.videoWidth
    );


  const width =
    Math.floor(
      video.videoWidth * scale
    );


  const height =
    Math.floor(
      video.videoHeight * scale
    );


  canvas.width = width;
  canvas.height = height;


  ctx.drawImage(
    video,
    0,
    0,
    width,
    height
  );


  const result =
    decodeBarcodeFromImage(
      ctx,
      width,
      height
    );


  if (result) {

    handleDetected(
      result
    );

  }

}


/*******************************************************
 * IMAGE DECODER
 *
 * Không tìm "*" .
 *
 * Đọc trực tiếp:
 * 9 phần tử / ký tự
 * 3 wide
 * 6 narrow
 *******************************************************/

function decodeBarcodeFromImage(
  ctx,
  width,
  height
) {


  /*
   * Quét nhiều dòng ngang.
   *
   * Barcode có thể hơi nghiêng,
   * nên không chỉ đọc đúng 1 dòng.
   */

  const positions = [
    0.32,
    0.38,
    0.44,
    0.50,
    0.56,
    0.62,
    0.68
  ];


  /*
   * Chỉ lấy vùng trung tâm,
   * tránh text / khung bên ngoài.
   */

  const x0 =
    Math.floor(width * 0.05);

  const x1 =
    Math.floor(width * 0.95);


  for (
    let i = 0;
    i < positions.length;
    i++
  ) {

    const y =
      Math.floor(
        height * positions[i]
      );


    const runs =
      getRuns(
        ctx,
        x0,
        x1,
        y
      );


    if (!runs ||
        runs.length < 20) {
      continue;
    }


    let result =
      decodeRuns(runs);


    if (result) {
      return result;
    }


    /*
     * Thử ngược chiều.
     * Code 39 có thể đọc hai chiều.
     */

    const reversed =
      runs
        .slice()
        .reverse();


    result =
      decodeRuns(reversed);


    if (result) {
      return result;
    }

  }


  return null;
}


/*******************************************************
 * LẤY RUN BLACK / WHITE
 *******************************************************/

function getRuns(
  ctx,
  x0,
  x1,
  y
) {


  const image =
    ctx.getImageData(
      x0,
      y,
      x1 - x0,
      1
    );


  const data =
    image.data;


  let min = 255;

  let max = 0;


  /*
   * Tìm min/max độ sáng
   */

  for (
    let i = 0;
    i < data.length;
    i += 4
  ) {

    const gray =
      0.299 * data[i] +
      0.587 * data[i + 1] +
      0.114 * data[i + 2];


    if (gray < min) min = gray;

    if (gray > max) max = gray;

  }


  /*
   * Ngưỡng tự động
   */

  const threshold =
    min + (max - min) * 0.50;


  const runs = [];


  let previous = null;

  let count = 0;


  for (
    let i = 0;
    i < data.length;
    i += 4
  ) {

    const gray =
      0.299 * data[i] +
      0.587 * data[i + 1] +
      0.114 * data[i + 2];


    const black =
      gray < threshold;


    if (
      previous === null
    ) {

      previous = black;
      count = 1;

    } else if (
      black === previous
    ) {

      count++;

    } else {

      runs.push({
        black: previous,
        width: count
      });

      previous = black;
      count = 1;

    }

  }


  if (count > 0) {

    runs.push({
      black: previous,
      width: count
    });

  }


  /*
   * Bỏ quiet zone trắng hai đầu
   */

  while (
    runs.length &&
    !runs[0].black
  ) {
    runs.shift();
  }


  while (
    runs.length &&
    !runs[runs.length - 1].black
  ) {
    runs.pop();
  }


  return runs;
}


/*******************************************************
 * DECODE RUNS
 *******************************************************/

function decodeRuns(runs) {

  if (!runs ||
      runs.length < 9) {
    return null;
  }


  /*
   * Thử nhiều vị trí bắt đầu.
   *
   * Vì barcode bị mất Start/Stop,
   * ta không có mẫu "*" để làm mốc.
   */

  const maxStart =
    Math.min(
      8,
      runs.length - 9
    );


  for (
    let start = 0;
    start <= maxStart;
    start++
  ) {


    if (!runs[start].black) {
      continue;
    }


    let pos = start;

    let output = '';

    let valid = true;


    while (
      pos + 8 <
      runs.length
    ) {


      /*
       * 1 ký tự Code 39 = 9 phần tử
       */

      const group =
        runs.slice(
          pos,
          pos + 9
        );


      if (
        group.length !== 9
      ) {

        valid = false;
        break;

      }


      /*
       * Phải xen kẽ Black / White
       */

      for (
        let i = 0;
        i < 9;
        i++
      ) {

        const expectedBlack =
          i % 2 === 0;


        if (
          group[i].black !==
          expectedBlack
        ) {

          valid = false;
          break;

        }

      }


      if (!valid) {
        break;
      }


      const character =
        decodeCharacter(group);


      if (!character) {

        valid = false;
        break;

      }


      output += character;


      pos += 9;


      /*
       * Sau mỗi ký tự có
       * 1 khoảng trắng inter-character.
       */

      if (
        pos < runs.length
      ) {

        if (
          runs[pos].black
        ) {

          valid = false;
          break;

        }


        pos++;

      }

    }


    /*
     * Chỉ chấp nhận MSSV
     */

    if (
      valid &&
      isValidMSSV(output)
    ) {

      return output;

    }

  }


  return null;
}


/*******************************************************
 * GIẢI MỘT KÝ TỰ CODE 39
 *******************************************************/

function decodeCharacter(group) {

  const widths =
    group.map(
      item => item.width
    );


  /*
   * Code 39 có:
   *
   * 3 phần tử wide
   * 6 phần tử narrow
   */

  const indexes =
    widths
      .map(
        (width, index) => ({
          width: width,
          index: index
        })
      )
      .sort(
        (a, b) =>
          b.width - a.width
      );


  /*
   * Ba phần tử lớn nhất = wide
   */

  const wideIndexes =
    indexes
      .slice(0, 3)
      .map(
        item => item.index
      );


  const bits =
    new Array(9).fill(0);


  wideIndexes.forEach(
    index => {
      bits[index] = 1;
    }
  );


  /*
   * Kiểm tra tỷ lệ wide/narrow.
   *
   * Code 39 chuẩn thường dùng
   * khoảng 2:1 đến 3:1.
   */

  const sorted =
    widths
      .slice()
      .sort(
        (a, b) => a - b
      );


  const narrowMedian =
    median(
      sorted.slice(0, 6)
    );


  const wideMedian =
    median(
      sorted.slice(6, 9)
    );


  if (
    narrowMedian <= 0 ||
    wideMedian <= 0
  ) {

    return null;

  }


  const ratio =
    wideMedian /
    narrowMedian;


  /*
   * Cho phép rộng hơn chuẩn một chút
   * để chịu được camera / blur / resize.
   */

  if (
    ratio < 1.30 ||
    ratio > 4.00
  ) {

    return null;

  }


  /*
   * Chuyển 9 bit thành số
   */

  let pattern = 0;


  for (
    let i = 0;
    i < 9;
    i++
  ) {

    if (bits[i]) {

      pattern |=
        1 << (8 - i);

    }

  }


  const index =
    CHARACTER_ENCODINGS.indexOf(
      pattern
    );


  if (index < 0) {
    return null;
  }


  return ALPHABET[index];
}


/*******************************************************
 * MEDIAN
 *******************************************************/

function median(arr) {

  if (!arr.length) {
    return 0;
  }


  const a =
    arr.slice().sort(
      (x, y) => x - y
    );


  const mid =
    Math.floor(
      a.length / 2
    );


  if (
    a.length % 2
  ) {

    return a[mid];

  }


  return (
    a[mid - 1] +
    a[mid]
  ) / 2;

}


/*******************************************************
 * KIỂM TRA MSSV
 *******************************************************/

function isValidMSSV(code) {

  code =
    String(code || '')
      .trim();


  /*
   * MSSV 25xxxxxxxx
   */

  if (
    /^25\d{8}$/.test(code)
  ) {
    return true;
  }


  /*
   * MSSV 26xxxxxxxx
   */

  if (
    /^26\d{8}$/.test(code)
  ) {
    return true;
  }


  /*
   * MSSV cũ 8 số
   */

  if (
    /^\d{8}$/.test(code)
  ) {
    return true;
  }


  return false;
}


/*******************************************************
 * KHI PHÁT HIỆN BARCODE
 *******************************************************/

function handleDetected(code) {

  /*
   * Không ghi cùng một mã liên tục.
   */

  const now =
    Date.now();


  if (
    code === lastSavedCode &&
    now - lastSavedAt < 2500
  ) {

    return;

  }


  lastSavedCode = code;

  lastSavedAt = now;


  document.getElementById(
    'currentMSSV'
  ).textContent = code;


  setStatus(
    'Đã nhận diện ' +
    code +
    ' — đang ghi dữ liệu...',
    'warning'
  );


  saveToSheet(code);

}


/*******************************************************
 * GHI SHEET
 *******************************************************/

function saveToSheet(code) {

  google.script.run

    .withSuccessHandler(
      function(result) {

        totalSaved++;


        setStatus(
          '✓ Đã ghi MSSV ' +
          result.mssv +
          ' lúc ' +
          result.time,
          'success'
        );


        addHistory(
          result.mssv,
          result.time
        );


        document.getElementById(
          'counter'
        ).textContent =
          'Đã ghi: ' +
          totalSaved;


        /*
         * Âm thanh báo thành công
         */

        beep();


        /*
         * Sau khi ghi xong,
         * sẵn sàng quét mã tiếp theo.
         */

      }
    )

    .withFailureHandler(
      function(error) {

        console.error(error);


        setStatus(
          error.message ||
          'Không thể ghi dữ liệu.',
          'error'
        );

      }
    )

    .saveScan(code);

}


/*******************************************************
 * NHẬP THỦ CÔNG
 *******************************************************/

function saveManual() {

  const input =
    document.getElementById(
      'manualInput'
    );


  const code =
    input.value
      .trim()
      .replace(/\s+/g, '');


  if (
    !isValidMSSV(code)
  ) {

    setStatus(
      'MSSV không đúng định dạng.',
      'error'
    );

    input.focus();

    return;

  }


  lastSavedCode = code;

  lastSavedAt = Date.now();


  document.getElementById(
    'currentMSSV'
  ).textContent = code;


  saveToSheet(code);


  input.value = '';

}


/*******************************************************
 * ENTER ĐỂ LƯU
 *******************************************************/

document
  .getElementById('manualInput')
  .addEventListener(
    'keydown',
    function(event) {

      if (
        event.key === 'Enter'
      ) {

        saveManual();

      }

    }
  );


/*******************************************************
 * LỊCH SỬ
 *******************************************************/

function addHistory(
  mssv,
  time
) {

  const list =
    document.getElementById(
      'historyList'
    );


  if (
    list.textContent ===
    'Chưa có dữ liệu'
  ) {

    list.innerHTML = '';

  }


  const item =
    document.createElement(
      'div'
    );


  item.className =
    'history-item';


  const code =
    document.createElement(
      'span'
    );


  code.className =
    'code';


  code.textContent =
    mssv;


  const t =
    document.createElement(
      'span'
    );


  t.className =
    'time';


  t.textContent =
    time;


  item.appendChild(code);

  item.appendChild(t);


  list.insertBefore(
    item,
    list.firstChild
  );


  /*
   * Chỉ giữ 20 dòng trên giao diện.
   * Sheet vẫn lưu đầy đủ.
   */

  while (
    list.children.length > 20
  ) {

    list.removeChild(
      list.lastChild
    );

  }

}


/*******************************************************
